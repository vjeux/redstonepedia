{
  "name": "normal-ticking physical dock: mixed raft pair",
  "setup": [
    "fill -12 200 -17 22 200 12 stone",
    "setworldspawn 5 201 -16",
    "forceload add -64 -64 64 64",
    "time set day"
  ],
  "steps": [
    {
      "rcon": "tag @a add mctas_probe"
    },
    {
      "rcon": "give @a lead 2"
    },
    {
      "rcon": "setblock -1 201 0 oak_fence"
    },
    {
      "rcon": "setblock 1 201 0 oak_fence"
    },
    {
      "rcon": "setblock 0 201 -1 oak_fence"
    },
    {
      "rcon": "setblock 0 201 1 oak_fence"
    },
    {
      "rcon": "summon bamboo_raft 0.5 201 0.5 {Tags:[\"mctas_probe\",\"boat_a\"]}"
    },
    {
      "rcon": "summon llama 0.5 201 0.5 {Tags:[\"mctas_probe\",\"holder_a\"],Age:0,Tame:1b}"
    },
    {
      "rcon": "setblock 9 201 0 oak_fence"
    },
    {
      "rcon": "setblock 11 201 0 oak_fence"
    },
    {
      "rcon": "setblock 10 201 -1 oak_fence"
    },
    {
      "rcon": "setblock 10 201 1 oak_fence"
    },
    {
      "rcon": "summon bamboo_raft 10.5 201 0.5 {Tags:[\"mctas_probe\",\"boat_b\"]}"
    },
    {
      "rcon": "summon llama 10.5 201 0.5 {Tags:[\"mctas_probe\",\"holder_b\"],Age:0,Tame:1b}"
    },
    {
      "step": 12
    },
    {
      "rcon": "tick unfreeze"
    },
    {
      "note": "NORMAL TICKING DOCK: both roots tick throughout attachment and mounting. Four ordinary fence posts constrain horizontal motion. Actor staging teleports are labeled fixture interventions, not a survival assembly claim. Actual launch positions/yaw/motion are measured, not reset."
    },
    {
      "rcon": "tp @a 11.5 202.5 0.5"
    },
    {
      "actor": "select 0"
    },
    {
      "actor": "look 11.1 201.5 0.5 3"
    },
    {
      "actor": "hit"
    },
    {
      "actor_expect": {
        "command": "click use",
        "contains": "class=Raft"
      }
    },
    {
      "rcon": "tp @a 1.5 202.5 0.5"
    },
    {
      "actor": "sneak 1"
    },
    {
      "actor": "look 0.5 203 0.5 3"
    },
    {
      "actor": "hit"
    },
    {
      "actor_expect": {
        "command": "click use",
        "contains": "class=Llama"
      }
    },
    {
      "actor": "sneak 0"
    },
    {
      "actor": "look 1.1 201.5 0.5 3"
    },
    {
      "actor": "hit"
    },
    {
      "actor_expect": {
        "command": "click use",
        "contains": "class=Raft"
      }
    },
    {
      "rcon": "tp @a 11.5 202.5 0.5"
    },
    {
      "actor": "select 1"
    },
    {
      "actor": "look 10.5 203 0.5 3"
    },
    {
      "actor": "hit"
    },
    {
      "actor_expect": {
        "command": "click use",
        "contains": "class=Llama"
      }
    },
    {
      "actor_expect": {
        "command": "probe_state",
        "contains": "root_authoritative=false"
      }
    },
    {
      "screenshot": "assembled.png"
    },
    {
      "rcon": "data get entity @e[tag=boat_a,limit=1]"
    },
    {
      "rcon": "data get entity @e[tag=boat_b,limit=1]"
    },
    {
      "graph": {
        "leashed": true,
        "mixed": true
      }
    },
    {
      "note": "LAUNCH: remove the complete command-built dock, including posts; normal 20TPS already running, no motion injection or tick exemption."
    },
    {
      "rcon": "fill -12 200 -12 22 203 12 air"
    },
    {
      "wait": 1000
    },
    {
      "screenshot": "after-20t.png"
    },
    {
      "wait": 3000
    },
    {
      "screenshot": "after-80t.png"
    },
    {
      "wait": 57000
    },
    {
      "rcon": "tick freeze"
    }
  ]
}